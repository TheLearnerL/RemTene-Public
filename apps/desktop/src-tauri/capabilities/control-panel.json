{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "control-panel",
  "description": "Control panel may read public state, manage settings, and access the LLM API key only through explicit secret-management commands; it never receives audio or target surfaces",
  "windows": ["control-panel"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-app-get-snapshot",
    "allow-model-check-health",
    "allow-model-switch-engine",
    "allow-model-open-directory",
    "allow-session-start",
    "allow-session-finish",
    "allow-session-cancel",
    "allow-permission-get-status",
    "allow-permission-request-microphone",
    "allow-permission-request-accessibility",
    "allow-permission-open-accessibility-settings",
    "allow-permission-open-microphone-settings",
    "allow-settings-get",
    "allow-settings-set-clipboard-bridge",
    "allow-settings-set-recording-preferences",
    "allow-settings-set-recording-shortcut",
    "allow-settings-set-history-enabled",
    "allow-settings-set-history-limit",
    "allow-settings-set-history-retention",
    "allow-settings-set-auto-copy-result",
    "allow-settings-set-local-diagnostics",
    "allow-diagnostics-open-directory",
    "allow-settings-set-text-processing",
    "allow-settings-set-llm",
    "allow-history-list",
    "allow-history-copy",
    "allow-history-clear-all",
    "allow-autostart-get-status",
    "allow-autostart-set-enabled",
    "allow-secret-get-llm-api-key-status",
    "allow-secret-set-llm-api-key",
    "allow-secret-reveal-llm-api-key",
    "allow-secret-delete-llm-api-key",
    "allow-secret-reset-unrecoverable-llm-secrets",
    "allow-llm-test-connection"
  ]
}
